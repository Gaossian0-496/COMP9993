# Datasets, third-party models and run output are not part of this repository.
dataset/
scscore/
results/
*.pkl
*.pt
*.bin
*.safetensors

# Run artefacts
*.done
*.status.json
*.ckpt.pkl
results_planning_*.yaml
*.jsonl
*.log
tensorboard/

# Skill stores (supply your own; see README)
skill_memory*.json
skill_library*.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Environment / editor
venv/
.venv/
.env
.DS_Store
*.swp
*~

# runs/ holds the three arms reported in the paper. The patterns above would
# otherwise swallow them, so re-include the artefacts that are small enough to
# version. Full LLM transcripts are still excluded: see runs/README.md.
!runs/**/*.status.json
!runs/**/*.yaml
!runs/**/*.jsonl
runs/**/llm_responses_*.jsonl
